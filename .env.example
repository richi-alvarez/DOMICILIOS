# ==============================================================================
# Domicilios — Variables de entorno
# ==============================================================================
# Copia este archivo a `.env` y completa los valores.
# Las marcadas como [REQUERIDO] son necesarias para que la app arranque.
# Las [OPCIONAL] habilitan funcionalidades concretas si se configuran.
# ==============================================================================

# ------------------------------------------------------------------------------
# Aplicación [REQUERIDO]
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Domicilios
# Entorno de ejecución: development | production | test
NODE_ENV=development

# ------------------------------------------------------------------------------
# Base de datos — PostgreSQL [REQUERIDO]
# ------------------------------------------------------------------------------
# Conexión al contenedor de Docker (docker-compose: servicio "postgres").
# Si corres la app FUERA de docker (npm run dev) usa host "localhost".
# Si corres la app DENTRO de docker-compose, cambia el host a "postgres".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domicilios

# Credenciales que consume docker-compose para inicializar PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=domicilios
DB_PORT=5432

# Puerto en el que se publica la app vía docker-compose
APP_PORT=3000

# pgAdmin (UI opcional de docker-compose)
PGADMIN_EMAIL=admin@domicilios.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ------------------------------------------------------------------------------
# Autenticación — Auth.js / NextAuth v5 [REQUERIDO]
# ------------------------------------------------------------------------------
# REQUERIDO. Genera el tuyo con: openssl rand -base64 32
# No pongas un valor real aquí: este archivo se versiona en git.
AUTH_SECRET=
# URL base de la app (NextAuth la usa para callbacks). En prod usa la URL pública.
AUTH_URL=http://localhost:3000

# OAuth Google [OPCIONAL] — habilita el login con Google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ------------------------------------------------------------------------------
# Email — Resend [OPCIONAL]
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@domicilios.app

# ------------------------------------------------------------------------------
# Alertas y notificaciones [OPCIONAL]
# ------------------------------------------------------------------------------
# Email destino para alertas críticas (vacío = deshabilitado)
ALERT_EMAIL_TO=
# Slack Incoming Webhook URL (vacío = deshabilitado)
SLACK_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# Inteligencia Artificial [OPCIONAL]
# ------------------------------------------------------------------------------
# Claves de proveedores. Configura al menos una para usar funciones de IA.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# OpenRouter: una sola clave da acceso a múltiples modelos (OpenAI, Anthropic, Llama…)
# La clave empieza por "sk-or-v1-". Obtén una en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo a usar en OpenRouter (formato proveedor/modelo). Default: openai/gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini

# Proveedor preferido: anthropic | openai | gemini | openrouter (default: anthropic)
AI_PROVIDER=anthropic
# Proveedores de fallback en orden, separados por coma (default: openai,gemini)
AI_FALLBACK_PROVIDERS=openai,gemini
# Límite de tokens por generación (default: 2048)
AI_DEFAULT_MAX_TOKENS=2048
# Temperatura de generación 0.0–1.0 (default: 0.7)
AI_DEFAULT_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# Pagos — Stripe (facturación SaaS) [OPCIONAL]
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# Caché / Colas — Redis [OPCIONAL]
# ------------------------------------------------------------------------------
# Usado por la caché de OCR y la cola del scanner.
# Solo se activa cuando NODE_ENV=production y REDIS_URL está definido.
# Apunta al contenedor de Docker (servicio "redis"). Usa "redis" como host
# si la app corre dentro de docker-compose.
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Scanner / OCR [OPCIONAL]
# ------------------------------------------------------------------------------
# Endpoint del servicio PaddleOCR (default: http://localhost:9000)
PADDLE_OCR_URL=http://localhost:9000
# Secreto compartido para validar el webhook del scanner
WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Imágenes — Unsplash [OPCIONAL]
# ------------------------------------------------------------------------------
# Access key para descargar imágenes de catálogo desde Unsplash
UNSPLASH_ACCESS_KEY=

# ------------------------------------------------------------------------------
# Tareas programadas — Cron [OPCIONAL]
# ------------------------------------------------------------------------------
# Secreto para autorizar los endpoints de cron (reportes programados, etc.)
CRON_SECRET=


# ------------------------------------------------------------------------------
# Whatsapp Business API [OPCIONAL]
# ------------------------------------------------------------------------------
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=domicilios_verify_token
META_WEBHOOK_URL=http://localhost:3000/api/webhooks/whatsapp
META_GRAPH_VERSION=v25.0
# Modo Humano: si está en true, el chat del cliente se reenvía al WhatsApp de la
# tienda y la tienda puede responder desde su propio número (además del panel).
# En false, el modo Humano se responde SOLO desde el panel administrativo.
WHATSAPP_STORE_REPLY=false