    "faqTitle": "Frequently asked questions",
    "faq": {
      "changePlan": {
        "q": "Can I change plans at any time?",
        "a": "Yes. You can upgrade or downgrade whenever you want. The change applies at the start of the next billing period."
      },
      "commissions": {
        "q": "Are there commissions on my sales?",
        "a": "We charge no commission on your sales. You only pay your subscription and your payment gateway fees (Stripe, MercadoPago, etc.)."
      },
      "freeLimit": {
        "q": "What happens if I exceed the order limit on the Free plan?",
        "a": "Your catalog stays active, but new orders are queued. We notify you so you can upgrade without losing orders."
      },
      "tryPro": {
        "q": "Can I try the Pro plan before paying?",
        "a": "All paid plans include a 14-day free trial with no credit card."
      },
      "annual": {
        "q": "How does annual billing work?",
        "a": "Annual billing is charged once at the start of the year. You save up to 33% compared to the monthly price."
      },
      "cancel": {
        "q": "Can I cancel at any time?",
        "a": "Yes. If you cancel, your plan stays active until the end of the paid period. No penalties."
      }
    }
  },
