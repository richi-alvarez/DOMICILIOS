# Local development overrides
# Copy to .env.local and customize

# Database (Docker - uncomment to use local docker postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domicilios

# Auth
AUTH_SECRET=dev-key-change-in-prod-DO-NOT-USE-IN-PRODUCTION-1234567890

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (get from Google Cloud Console)
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# Stripe (test keys from stripe.com/test)
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_test_publishable_key_here

# Resend API (dev mode - get at resend.com)
RESEND_API_KEY=re_your_test_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Anthropic (optional - for RAG)
ANTHROPIC_API_KEY=sk-ant-your-api-key

# OpenIA
OPENAI_API_KEY=sk-proj-your-api-key

OPENROUTER_API_KEY=
OPENREOUTER_MODEL=
# Storage (optional - S3/Supabase)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=


META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0