# Docker Development Environment
# Copy this to .env when working with Docker

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=domicilios
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/domicilios

# App Configuration
NODE_ENV=development
APP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Domicilios

# Auth Configuration (Auth.js)
AUTH_URL=http://localhost:3000
AUTH_SECRET=dev-secret-key-change-in-production-12345678

# OAuth (Google) - Get these from Google Cloud Console
AUTH_GOOGLE_ID=your_google_id_here
AUTH_GOOGLE_SECRET=your_google_secret_here

# Email Service (Resend)
RESEND_API_KEY=your_resend_key_here
RESEND_FROM_EMAIL=noreply@domicilios.app

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_key_here

# AI (Anthropic) - Optional for RAG features
ANTHROPIC_API_KEY=your_anthropic_key_here

# Storage (S3 / Supabase Storage) - Optional
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# pgAdmin Configuration (for database UI)
PGADMIN_EMAIL=admin@domicilios.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
